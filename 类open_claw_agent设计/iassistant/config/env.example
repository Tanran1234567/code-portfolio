# NOTE: 补充完环境变量后，将文件重命名为`.env`即可

# Aliyun bailian API
# base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
# models: qwen-plus-2025-04-28, text-embedding-v3, deepseek-r1, deepseek-v3
#   qwen-plus, qwen-flash, qwen-max
QWEN_API_AUTH_KEY=xxx

# Doubao volcengine API
# base_url: https://ark.cn-beijing.volces.com/api/v3
# models: doubao-1-5-pro-32k-250115, doubao-seed-1-6-250615
DOUBAO_API_AUTH_KEY=xxx

# DeepSeek API
# base_url: https://api.deepseek.com
# models: deepseek-chat (V3), deepseek-reasoner (R1)
DEEPSEEK_API_AUTH_KEY=xxx

DRAMATIQ_BROKER_HOST="127.0.0.1"
DRAMATIQ_BROKER_PORT=6379
# 工具链平台默认使用 db=0，此平台默认使用 db=1
DRAMATIQ_BROKER_DB=1
DRAMATIQ_BROKER_PASSWD=***

MONGODB_PASSWD=***

APP_LOG_LEVEL=INFO
FASTAPI_APP_PORT=8080

