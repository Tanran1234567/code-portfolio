# Clin-JEPA — environment variable template
# Copy to `.env` and fill in your local paths, OR `export` these in your shell
# before running any pipeline step.

# === Raw MIMIC-IV data root ===
# Path to your downloaded MIMIC-IV v3.1 release from PhysioNet.
# Expected layout: $MIMIC_RAW/icu/icustays.csv.gz, $MIMIC_RAW/hosp/labevents.csv.gz, etc.
# See docs/data-preparation.md for full download instructions.
MIMIC_RAW=/path/to/mimic-iv-3.1

# === Processed-data root ===
# Where step01-step06 write per-stay parquets, trajectory shards, and label tables.
# Needs ~10 GB free for the full pipeline output.
CLIN_JEPA_DATA=/path/to/clin_jepa_processed

# === Training / evaluation output root ===
# Where checkpoints, logs, embedding caches, and evaluation results are written.
# The Clin-JEPA training checkpoint is ~370 MB; the embedding cache is ~91 GB.
CLIN_JEPA_OUTPUT=/path/to/clin_jepa_outputs

# === HuggingFace cache ===
# Where Qwen3-8B base weights are downloaded (~16 GB).
# If unset, HuggingFace defaults to $HOME/.cache/huggingface.
HF_HOME=/path/to/huggingface

# === Grounding-Ward v4.4 ===
MIMIC_DUCKDB=/path/to/mimic4.db
GROUNDING_RAW_ROOT=/path/to/grounding_ward_v4_raw
GROUNDING_DATA_ROOT=/path/to/grounding_ward_v4
GROUNDING_OUTPUT=/path/to/output_grounding_ward_v4
QWEN_PATH=/path/to/Qwen3-8B

# === ICU-free 3000-patient creatinine encoder experiment ===
CREATININE_WARD_DATA_ROOT=/path/to/creatinine_ward_v1_data
CREATININE_WARD_OUTPUT=/path/to/creatinine_ward_v1_output
# New output root for the action-aligned predictor retraining. Keep the v1
# output above because its encoder_sft/best is reused.
CREATININE_WARD_V2_OUTPUT=/path/to/creatinine_ward_v2_action_aligned_output
